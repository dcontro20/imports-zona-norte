<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent del worker del Discovery Engine (IZN).
  Corre cada 5 minutos en la Mac de Gustavo: toma los jobs de búsqueda
  pendientes, scrapea con gosom y deja los resultados en el staging.
  El claim transaccional del worker hace inofensivo el solapamiento
  (un scrape largo puede durar más que el intervalo).

  Instalar:
    cp scripts/discovery/com.izn.discovery.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.izn.discovery.plist

  Probar ahora mismo:
    launchctl start com.izn.discovery

  Ver logs:
    tail -f /tmp/izn-discovery.log
    tail /tmp/izn-discovery.err

  Deshabilitar:
    launchctl unload ~/Library/LaunchAgents/com.izn.discovery.plist

  Setup completo (binario + service account): scripts/DISCOVERY_SETUP.md
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.izn.discovery</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/node</string>
        <string>/Users/Gustavo/Desktop/imports-zona-norte/scripts/discovery/worker.mjs</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/Gustavo/Desktop/imports-zona-norte</string>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/izn-discovery.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/izn-discovery.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/Gustavo</string>
    </dict>
</dict>
</plist>
