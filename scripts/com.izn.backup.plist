<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent para backup diario IZN a Google Drive.
  Corre cada día a las 3:03 AM.

  Instalar:
    cp scripts/com.izn.backup.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.izn.backup.plist

  Probar ahora mismo (sin esperar):
    launchctl start com.izn.backup

  Ver logs:
    tail /tmp/izn-backup.log
    tail /tmp/izn-backup.err

  Deshabilitar:
    launchctl unload ~/Library/LaunchAgents/com.izn.backup.plist

  Nota: si el proyecto está en ~/Desktop/, macOS puede pedir "Full Disk Access"
  para /usr/local/bin/node la primera vez. Se activa en:
  System Settings → Privacy & Security → Full Disk Access → [+ node]
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.izn.backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/node</string>
        <string>/Users/Diego/Desktop/imports-zona-norte/scripts/backup.mjs</string>
        <string>--upload</string>
        <string>--quiet</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/Diego/Desktop/imports-zona-norte</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>3</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/izn-backup.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/izn-backup.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/Diego</string>
    </dict>
</dict>
</plist>
