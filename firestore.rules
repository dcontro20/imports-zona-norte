rules_version = '2';

// Reglas de Firestore para Imports Zona Norte
// Deploy: firebase deploy --only firestore:rules
//
// Modelo de permisos:
//   - Socios (Diego dcontro20@gmail.com + Gustavo gcontro99@gmail.com):
//     ambos con acceso total (sociedad 50/50 desde 2026-06-22).
//   - Cualquier otro usuario: denied.
//
// Storage pattern: todos los datos viven en /appData/{key} como doc único
// con JSON.stringify del array. Writes son full-doc replace.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
          && (request.auth.token.email == "dcontro20@gmail.com"
              || request.auth.token.email == "gcontro99@gmail.com");
    }

    // Cada doc es { data: "<JSON string>", updatedAt: "<ISO>" }.
    // Validamos forma y tamaño para evitar writes malformados o gigantes
    // (un JSON > ~900KB rompería la app al hacer JSON.parse y/o inflaría costos).
    match /appData/{key} {
      allow read: if isOwner();
      allow write: if isOwner()
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000
        && request.resource.data.updatedAt is string;
    }

    // Push remotas (FCM): tokens de dispositivos + config de horarios.
    // El cliente (Diego logueado) escribe acá; el endpoint serverless
    // lee con Admin SDK (bypasea rules).
    match /pushTokens/{token} {
      allow read, write: if isOwner();
    }

    // Presencia en tiempo real (heartbeat de cada socio). Ambos owners leen
    // todo y escriben; el doc es chico (name/page/lastSeen).
    match /presence/{uid} {
      allow read, write: if isOwner();
    }
    match /push/{docId} {
      allow read, write: if isOwner();
    }

    // Discovery Engine (docs/DISCOVERY_ENGINE_CONTRATO.md §3/§4/§8):
    // - discoveryJobs: la app crea la búsqueda y puede cancelarla; el worker
    //   (Admin SDK, bypasea rules) la toma y la cierra.
    // - discoveryResults: staging que escribe SOLO el worker; la app lee y
    //   borra el doc una vez consumido en la revisión. No crea ni edita.
    match /discoveryJobs/{jobId} {
      allow read, write: if isOwner();
    }
    match /discoveryResults/{resultId} {
      allow read, delete: if isOwner();
      allow create, update: if false;
    }

    // Fallback: cualquier otra colección — cerrada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
