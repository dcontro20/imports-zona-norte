rules_version = '2';

// Reglas de Firestore para Imports Zona Norte
// Deploy: firebase deploy --only firestore:rules
//
// Modelo de permisos:
//   - Owner (Diego, dcontro20@gmail.com): único usuario con acceso total.
//   - Cualquier otro usuario: denied.
//
// Storage pattern: todos los datos viven en /appData/{key} como doc único
// con JSON.stringify del array. Writes son full-doc replace.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
          && request.auth.token.email == "dcontro20@gmail.com";
    }

    match /appData/{key} {
      allow read, write: if isOwner();
    }

    // Fallback: cualquier otra colección — cerrada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
