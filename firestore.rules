rules_version = '2';

// Reglas de Firestore para Imports Zona Norte
// Deploy: firebase deploy --only firestore:rules
//
// Modelo de permisos:
//   - Socios (Diego dcontro20@gmail.com + Gustavo gcontro99@gmail.com):
//     ambos con acceso total (sociedad 50/50 desde 2026-06-22).
//   - Cualquier otro usuario: denied.
//
// Storage pattern: todos los datos viven en /appData/{key} como doc único
// con JSON.stringify del array. Writes son full-doc replace.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
          && (request.auth.token.email == "dcontro20@gmail.com"
              || request.auth.token.email == "gcontro99@gmail.com");
    }

    match /appData/{key} {
      allow read, write: if isOwner();
    }

    // Push remotas (FCM): tokens de dispositivos + config de horarios.
    // El cliente (Diego logueado) escribe acá; el endpoint serverless
    // lee con Admin SDK (bypasea rules).
    match /pushTokens/{token} {
      allow read, write: if isOwner();
    }
    match /push/{docId} {
      allow read, write: if isOwner();
    }

    // Fallback: cualquier otra colección — cerrada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
